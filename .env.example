# Google AI Studio kaliti: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ixtiyoriy: model nomlarini o'zgartirish
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# ---------- Gmail orqali kirish (Google OAuth) ----------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: https://<sayt>/api/auth/callback  (lokal: http://localhost:3000/api/auth/callback)
# Ikkalasi bo'sh bo'lsa, login o'chadi va AI hammaga ochiq ishlaydi (eski rejim).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sessiya cookie'larini imzolash uchun tasodifiy satr (kamida 32 belgi): openssl rand -base64 32
AUTH_SECRET=
# Saytning to'liq manzili (redirect URI va to'lovdan qaytish uchun), masalan https://hanqadam.uz
APP_URL=
# Admin panel (/admin) uchun email(lar), vergul bilan
ADMIN_EMAILS=

# ---------- Ma'lumotlar bazasi (foydalanuvchilar, obunalar, to'lovlar) ----------
# Vercel → Storage → Marketplace → Upstash Redis (KV_* o'zgaruvchilar avtomatik qo'shiladi)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Yoki: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# O'z serveringizda (VPS, bitta jarayon) Redis'siz ishlatish uchun: ALLOW_FILE_DB=1 (.data/db.json)
# ALLOW_FILE_DB=1

# ---------- To'lov: Payme (Merchant API) ----------
# Kabinet: Endpoint URL = https://<sayt>/api/billing/payme, hisob maydoni = order_id
PAYME_MERCHANT_ID=
PAYME_KEY=
# Sinov muhiti (checkout.test.paycom.uz) uchun 1, PAYME_KEY ga test kalitini yozing
# PAYME_TEST=1
# Fiskal chek (OFD) uchun MXIK (ИКПУ) kodi va qadoq kodi — ixtiyoriy
# PAYME_IKPU=
# PAYME_PACKAGE_CODE=
# PAYME_VAT_PERCENT=0

# ---------- To'lov: Click (SHOP API) ----------
# Kabinet: Prepare URL va Complete URL = https://<sayt>/api/billing/click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Onlayn to'lov ulanmaguncha "Administratorga yozish" tugmasi uchun (masalan Telegram)
# NEXT_PUBLIC_SUPPORT_URL=https://t.me/your_username
