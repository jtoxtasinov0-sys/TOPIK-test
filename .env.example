# Google AI Studio kaliti: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ixtiyoriy: model nomlarini o'zgartirish
# GEMINI_MODEL=gemini-3.8-flash
# Erkin suhbat (/speak/free) uchun alohida, tezroq model (bo'sh bo'lsa — GEMINI_MODEL)
# GEMINI_TALK_MODEL=
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Test rasmlari uchun rasm modeli. Bo'sh bo'lsa, kalitga ochiq modellardan eng yangi "flash" rasm modeli avtomatik tanlanadi
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Rasmlar saqlanadigan papka (standart: db.json yonidagi images/, Docker'da /app/data/images)
# IMAGE_DIR=

# ---------- Gmail orqali kirish (Google OAuth) ----------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: https://<sayt>/api/auth/callback  (lokal: http://localhost:3000/api/auth/callback)
# Ikkalasi bo'sh bo'lsa, login o'chadi va AI hammaga ochiq ishlaydi (eski rejim).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sessiya cookie'larini imzolash uchun tasodifiy satr (kamida 32 belgi): openssl rand -base64 32
AUTH_SECRET=
# Saytning to'liq manzili (Google redirect URI uchun), masalan https://hanustoz.uz
APP_URL=
# Admin panel (/admin) uchun email(lar), vergul bilan
ADMIN_EMAILS=
# Bepul sinov necha kun (standart 7) — o'zgartirilsa faqat yangi foydalanuvchilarga ta'sir qiladi
# NEXT_PUBLIC_TRIAL_DAYS=7

# ---------- Ma'lumotlar bazasi (foydalanuvchilar va bepul sinov muddati) ----------
# Vercel → Storage → Marketplace → Upstash Redis (KV_* o'zgaruvchilar avtomatik qo'shiladi)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Yoki: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# O'z serveringizda (VPS, bitta jarayon) Redis'siz ishlatish uchun: ALLOW_FILE_DB=1 (.data/db.json)
# ALLOW_FILE_DB=1

# ---------- Obuna to'lovlari (qo'lda tasdiqlanadi, /pay va /admin) ----------
# O'zbekiston: Humo / Uzcard karta raqami va egasining ismi
# PAY_UZ_CARD=8600 1234 5678 9012
# PAY_UZ_NAME=ALIYEV VALI
# Koreya: bank va hisob raqami (계좌), egasi (예금주)
# PAY_KR_ACCOUNT=KB국민 123456-01-123456
# PAY_KR_NAME=ALIYEV VALI
# Savol va muammolar uchun (Telegram)
# PAY_CONTACT=@hanustoz_admin
# Har bir «To'ladim» haqida Telegram'ga xabar (ixtiyoriy): @BotFather'dan bot tokeni va sizning chat ID
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Chek rasmlari papkasi (standart: db.json yonidagi receipts/, Docker'da /app/data/receipts)
# RECEIPT_DIR=
